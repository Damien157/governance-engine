# Customer ops — example env for the governed sidecar (copy & edit; do not commit secrets).
# See docs/CUSTOMER_OPS.md

# --- Bind ---
GOVERNANCE_HOST=127.0.0.1
GOVERNANCE_PORT=8080

# --- Durable audit + signing (local KMS-shaped; not cloud HSM) ---
GOVERNANCE_DB_PATH=artifacts/customer/audit.db
GOVERNANCE_SIGNING_KEY_PATH=artifacts/customer/signing_key.pem
# Optional: PEM text instead of path (EnvKMSKeyProvider stand-in)
# GOVERNANCE_SIGNING_KEY_PEM=

# Production posture: refuse ephemeral keys if path missing
GOVERNANCE_REQUIRE_PERSISTED_KEY=1

# --- Customer API auth (optional). If set, /v1/* requires header X-API-Key ---
# Single-tenant:
# GOVERNANCE_API_KEY=replace-me-with-a-long-random-string

# Multi-tenant lite (prefer one of these; disables single-key-only mapping when set):
# Simple: tenant_id:api_key pairs → artifacts/tenants/<id>/audit.db
# (signing key: per-tenant PEM if present, else GOVERNANCE_SIGNING_KEY_PATH)
# GOVERNANCE_API_KEYS=acme:key-acme-...,globex:key-globex-...
#
# Rich JSON map (db_path / signing_key_path optional per tenant):
# GOVERNANCE_TENANTS_JSON={"acme":{"api_key":"key-acme-...","db_path":"artifacts/tenants/acme/audit.db"}}
#
# Optional master key: X-API-Key=<master> + X-Tenant-Id=<id> selects a configured tenant
# GOVERNANCE_MASTER_API_KEY=

# --- Rate limit (in-memory sliding window; /v1/* only; per tenant or "default") ---
# GOVERNANCE_RATE_LIMIT_PER_MIN=60
# Set to 0 to disable.

# --- Sidecar logging ---
# GOVERNANCE_SIDECAR_VERBOSE=1
